# Server-side Gemini / Argon API credentials (never expose to client bundle)
GEMINI_API_KEY=
# Model identifier for Argon review & repair calls
GEMINI_MODEL=gemini-2.5-pro
# Backend server port (Vite proxies /api to this port)
PORT=3001
# Directory for persisted RunRecord JSON and uploaded evidence videos
RUNS_DIR=./runs
